{
  "sourceLanguage": "en",
  "strings": {
    "Can't reach the server": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nicht erreichbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur injoignable"
          }
        }
      }
    },
    "Check for Updates…": {
      "localizations": {
