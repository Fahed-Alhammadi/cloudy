    "The download does not contain Cloudy Drive.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي التنزيل على Cloudy Drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download enthält Cloudy Drive nicht."
          }
        },
