            "value": "Sesión iniciada como %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connecté en tant que %@"
          }
        }
      }
    },
    "Switch On in System Settings…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التشغيل من إعدادات النظام…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In den Systemeinstellungen einschalten…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activar en Ajustes del Sistema…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activer dans Réglages Système…"
          }
        }
      }
    },
    "The server's HTTPS certificate isn't trusted": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهادة HTTPS الخاصة بالخادم غير موثوقة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das HTTPS-Zertifikat des Servers ist nicht vertrauenswürdig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado HTTPS del servidor no es de confianza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat HTTPS du serveur n’est pas fiable"
          }
        }
      }
    },
    "This server needs an https:// address. Plain http:// only works on your local network.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج هذا الخادم إلى عنوان https://. يعمل http:// العادي على شبكتك المحلية فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server braucht eine https://-Adresse. Einfaches http:// funktioniert nur im lokalen Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor necesita una dirección https://. El http:// simple solo funciona en tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur nécessite une adresse https://. Le simple http:// ne fonctionne que sur votre réseau local."
          }
        }
      }
    },
    "Two-factor code": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رمز التحقق بخطوتين"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwei-Faktor-Code"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Código de dos factores"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Code à deux facteurs"
          }
        }
      }
    },
    "Username": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzername"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de usuario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom d'utilisateur"
          }
        }
      }
    },
    "You were signed out. Sign in again to keep using Cloudy in Finder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل خروجك. سجّل الدخول مرة أخرى لمتابعة استخدام Cloudy في Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wurdest abgemeldet. Melde dich erneut an, um Cloudy weiter im Finder zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerró tu sesión. Vuelve a iniciar sesión para seguir usando Cloudy en Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez été déconnecté. Reconnectez-vous pour continuer à utiliser Cloudy dans le Finder."
          }
        }
      }
    },
    "You're offline": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل بالإنترنت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne"
          }
        }
      }
    },
    "Your Cloudy files in Finder. They take no space on this Mac until you open them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفاتك في Cloudy داخل Finder. لا تشغل أي مساحة على هذا الـ Mac حتى تفتحها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Cloudy-Dateien im Finder. Sie belegen keinen Platz auf diesem Mac, bis du sie öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos de Cloudy en Finder. No ocupan espacio en este Mac hasta que los abres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers Cloudy dans le Finder. Ils n’occupent aucun espace sur ce Mac tant que vous ne les ouvrez pas."
          }
        }
      }
    },
    "conflicted copy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخة متعارضة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfliktkopie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "copia en conflicto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "copie en conflit"
          }
        }
      }
    }
  },
  "version": "1.0"
