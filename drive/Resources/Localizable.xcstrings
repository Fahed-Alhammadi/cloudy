          }
        }
      }
    },
    "Update to Cloudy Drive %@…": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحديث إلى Cloudy Drive %@…"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf Cloudy Drive %@ aktualisieren…"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizar a Cloudy Drive %@…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre à jour vers Cloudy Drive %@…"
          }
        }
      }
    },
    "Username": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسم المستخدم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzername"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombre de usuario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nom d'utilisateur"
          }
        }
      }
    },
    "You have version %@. Cloudy Drive can't replace itself in this folder; download the new version instead.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك الإصدار %@. لا يستطيع Cloudy Drive استبدال نفسه في هذا المجلد، لذا نزّل الإصدار الجديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Version %@. Cloudy Drive kann sich in diesem Ordner nicht ersetzen; lade stattdessen die neue Version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes la versión %@. Cloudy Drive no puede reemplazarse en esta carpeta; descarga la nueva versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez la version %@. Cloudy Drive ne peut pas se remplacer dans ce dossier ; téléchargez plutôt la nouvelle version."
          }
        }
      }
    },
    "You have version %@. Download and install it now? Cloudy Drive will relaunch.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك الإصدار %@. هل تريد تنزيله وتثبيته الآن؟ سيُعاد تشغيل Cloudy Drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Version %@. Jetzt laden und installieren? Cloudy Drive wird neu gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes la versión %@. ¿Descargarla e instalarla ahora? Cloudy Drive se reiniciará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez la version %@. La télécharger et l’installer maintenant ? Cloudy Drive va redémarrer."
          }
        }
      }
    },
    "You have version %@. Download it from GitHub.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك الإصدار %@. نزّل الإصدار الجديد من GitHub."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Version %@. Lade die neue Version von GitHub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes la versión %@. Descarga la nueva desde GitHub."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez la version %@. Téléchargez la nouvelle sur GitHub."
          }
        }
      }
    },
    "You have version %@. Move Cloudy Drive to the Applications folder to install updates.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك الإصدار %@. انقل Cloudy Drive إلى مجلد التطبيقات لتثبيت التحديثات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast Version %@. Bewege Cloudy Drive in den Ordner „Programme“, um Updates zu installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tienes la versión %@. Mueve Cloudy Drive a la carpeta Aplicaciones para instalar actualizaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez la version %@. Placez Cloudy Drive dans le dossier Applications pour installer les mises à jour."
          }
        }
      }
    },
    "You were signed out. Sign in again to keep using Cloudy in Finder.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم تسجيل خروجك. سجّل الدخول مرة أخرى لمتابعة استخدام Cloudy في Finder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du wurdest abgemeldet. Melde dich erneut an, um Cloudy weiter im Finder zu nutzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cerró tu sesión. Vuelve a iniciar sesión para seguir usando Cloudy en Finder."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez été déconnecté. Reconnectez-vous pour continuer à utiliser Cloudy dans le Finder."
          }
        }
      }
    },
    "You're offline": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل بالإنترنت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes hors ligne"
          }
        }
      }
    },
    "You're up to date": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لديك أحدث إصدار"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles aktuell"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Está actualizado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes à jour"
          }
        }
      }
    },
    "Your Cloudy files in Finder. They take no space on this Mac until you open them.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملفاتك في Cloudy داخل Finder. لا تشغل أي مساحة على هذا الـ Mac حتى تفتحها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Cloudy-Dateien im Finder. Sie belegen keinen Platz auf diesem Mac, bis du sie öffnest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus archivos de Cloudy en Finder. No ocupan espacio en este Mac hasta que los abres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos fichiers Cloudy dans le Finder. Ils n’occupent aucun espace sur ce Mac tant que vous ne les ouvrez pas."
          }
        }
      }
    },
    "conflicted copy": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نسخة متعارضة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfliktkopie"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "copia en conflicto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "copie en conflit"
          }
        }
      }
    }
  },
  "version": "1.0"
}