            "state": "translated",
            "value": "La descarga no contiene Cloudy Drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement ne contient pas Cloudy Drive."
          }
        }
      }
    },
    "The download is damaged (checksum mismatch).": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنزيل تالف (المجموع الاختباري غير مطابق)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download ist beschädigt (Prüfsumme stimmt nicht)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga está dañada (la suma de verificación no coincide)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement est endommagé (somme de contrôle incorrecte)."
          }
        }
      }
    },
    "The download is not signed by the Cloudy Drive developer.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنزيل غير موقّع من مطوّر Cloudy Drive."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download ist nicht vom Entwickler von Cloudy Drive signiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La descarga no está firmada por el desarrollador de Cloudy Drive."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le téléchargement n’est pas signé par le développeur de Cloudy Drive."
          }
        }
      }
    },
    "The server's HTTPS certificate isn't trusted": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شهادة HTTPS الخاصة بالخادم غير موثوقة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das HTTPS-Zertifikat des Servers ist nicht vertrauenswürdig"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El certificado HTTPS del servidor no es de confianza"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le certificat HTTPS du serveur n’est pas fiable"
          }
        }
      }
    },
    "This server needs an https:// address. Plain http:// only works on your local network.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج هذا الخادم إلى عنوان https://. يعمل http:// العادي على شبكتك المحلية فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Server braucht eine https://-Adresse. Einfaches http:// funktioniert nur im lokalen Netzwerk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este servidor necesita una dirección https://. El http:// simple solo funciona en tu red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce serveur nécessite une adresse https://. Le simple http:// ne fonctionne que sur votre réseau local."
          }
        }
      }
    },
    "Two-factor code": {
      "localizations": {
        "ar": {
          "stringUnit": {
