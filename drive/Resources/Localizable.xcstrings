            "value": "Descargar Cloudy Drive %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Télécharger Cloudy Drive %@"
          }
        }
      }
    },
    "Download failed (HTTP %lld)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل التنزيل (HTTP %lld)"
