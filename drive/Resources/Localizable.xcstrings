{
  "sourceLanguage": "en",
  "strings": {
    "Can't reach the server": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر الوصول إلى الخادم"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server nicht erreichbar"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede conectar con el servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveur injoignable"
          }
        }
      }
    },
    "Cloudy Drive": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy Drive"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy Drive"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy Drive"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy Drive"
          }
        }
      }
    },
    "Cloudy doesn't collect any data. Everything stays between this app and the server you sign in to.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يجمع Cloudy أي بيانات. كل شيء يبقى بين هذا التطبيق والخادم الذي تسجّل الدخول إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy sammelt keine Daten. Alles bleibt zwischen dieser App und dem Server, bei dem du dich anmeldest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy no recopila ningún dato. Todo queda entre esta app y el servidor en el que inicias sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy ne collecte aucune donnée. Tout reste entre cette app et le serveur auquel vous vous connectez."
          }
        }
      }
    },
    "Cloudy is switched off in Finder": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy متوقف في Finder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy ist im Finder ausgeschaltet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy está desactivado en Finder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy est désactivé dans le Finder"
          }
        }
      }
    },
    "Download Cloudy Drive %@": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنزيل Cloudy Drive %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cloudy Drive %@ laden"
