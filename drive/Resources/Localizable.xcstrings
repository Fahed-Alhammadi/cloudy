        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo terminó antes del tamaño indicado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier se termine avant la taille annoncée"
          }
        }
      }
    },
    "Forgot password?": {
      "localizations": {
        "ar": {
          "stringUnit": {
