        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du téléchargement (HTTP %lld)"
          }
        }
      }
    },
    "File ended before the declared size": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهى الملف قبل الحجم المعلن"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Datei endet vor der angegebenen Größe"
