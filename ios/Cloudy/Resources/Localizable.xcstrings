    "Anyone with the link can open it, no account needed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأي شخص لديه الرابط فتحه دون الحاجة إلى حساب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder mit dem Link kann ihn öffnen, ohne Konto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquiera con el enlace puede abrirlo, sin necesidad de cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toute personne disposant du lien peut l’ouvrir, sans compte."
          }
