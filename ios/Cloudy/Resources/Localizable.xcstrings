    "\"%@\" will be deleted forever.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتم حذف \"%@\" نهائيًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ wird endgültig gelöscht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" se eliminará para siempre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » sera supprimé définitivement."
          }
