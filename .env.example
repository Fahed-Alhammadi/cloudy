# Copy to .env and change these.
DB_PASSWORD=change-me-db-password
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password

# Port the app is published on (host side). APP_BIND=127.0.0.1 keeps it
# reachable only from this machine, e.g. when your reverse proxy runs on the host.
APP_PORT=8080
# APP_BIND=127.0.0.1

# Set to true once the app sits behind your reverse proxy, so the real client
# IP (X-Forwarded-For) and HTTPS (X-Forwarded-Proto) are honored.
# Keep false while the port is exposed directly — those headers can be spoofed.
TRUST_PROXY=false

TRASH_RETENTION_DAYS=30
MAX_VERSIONS=20

# --- Updates -------------------------------------------------------------
# Published image to run instead of building locally, e.g. ghcr.io/fahed-alhammadi/filecloud:latest
# FILECLOUD_IMAGE=filecloud:local
# GitHub "owner/repo" checked for new releases (shown in Administration).
# UPDATE_REPO=Fahed-Alhammadi/filecloud
# With `docker compose --profile autoupdate up -d`, check for a new image every N seconds.
# UPDATE_INTERVAL=21600
