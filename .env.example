# FileCloud settings. Copy to .env and adjust; every value here is optional except ADMIN_PASSWORD.

# --- First administrator (created on first start) -------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Network ----------------------------------------------------------------
APP_PORT=8080
# APP_BIND=127.0.0.1        # only reachable from this machine (e.g. reverse proxy on the same host)
# Set to true once FileCloud sits behind your reverse proxy (real client IPs + HTTPS cookies).
TRUST_PROXY=false

# --- Storage ----------------------------------------------------------------
# User the container runs as (uid:gid) — owns the files it writes.
APP_USER=1000:1000
# User files: a Docker volume name, or a host folder such as your NFS mount (e.g. /mnt/filecloud).
DATA_PATH=app-data
# Database files: a Docker volume name or a host folder. Keep it on a local disk, not NFS.
DB_PATH=db-data
# Use an external PostgreSQL instead of the built-in one:
# DATABASE_URL=postgres://user:password@host:5432/filecloud

# --- Files ------------------------------------------------------------------
TRASH_RETENTION_DAYS=30
MAX_VERSIONS=20
