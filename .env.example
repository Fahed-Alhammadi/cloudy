# Cloudy settings. Optional: docker-compose.yml already lists every setting with its default.
# Copy to .env and change what you need; values here override the defaults in docker-compose.yml.

# --- First administrator (created on first start) -------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-admin-password

# --- Network ----------------------------------------------------------------
APP_PORT=8080
# APP_BIND=127.0.0.1        # only reachable from this machine (e.g. reverse proxy on the same host)
# Set to true once Cloudy sits behind your reverse proxy (real client IPs + HTTPS cookies).
TRUST_PROXY=false
# Address users open Cloudy at. Passkeys are bound to it; set it if your proxy doesn't forward Host.
# PUBLIC_URL=https://cloud.example.com

# --- Office editor (built-in Collabora Online) -----------------------------
# OFFICE=false               # don't start it (saves ~1 GB of RAM)
# OFFICE_HOME_MODE=true      # hide welcome/feedback pop-ups; limits to 20 connections / 10 documents
# COLLABORA_URL=http://collabora:9980   # use an external Collabora instead of the built-in one

# --- Storage ----------------------------------------------------------------
# User the container runs as (uid:gid) — owns the files it writes.
APP_USER=1000:1000
# User files: a Docker volume name, or a host folder such as your NFS mount (e.g. /mnt/cloudy).
DATA_PATH=app-data
# Database files: a Docker volume name or a host folder. Keep it on a local disk, not NFS.
DB_PATH=db-data
# Use an external PostgreSQL instead of the built-in one:
# DATABASE_URL=postgres://user:password@host:5432/cloudy

# --- Files ------------------------------------------------------------------
TRASH_RETENTION_DAYS=30
MAX_VERSIONS=20
# How long a browser login lasts (days).
SESSION_DAYS=14
